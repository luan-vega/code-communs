<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.luanvega.communs</groupId>
        <artifactId>communs-arch-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>communs-arch-junit</artifactId>
    <description>Integração com JUnit 6: @AnalisarClasses e @RegraArch.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>communs-arch-library</artifactId>
        </dependency>
        <!-- Engine própria do JUnit Platform (como o archunit-junit5), para rodar campos @RegraArch como testes. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- As classes de exemplo dos testes violam regras de propósito; elas rodam só pelo EngineTestKit. -->
                    <excludeJUnit5Engines>
                        <excludeJUnit5Engine>communs-arch</excludeJUnit5Engine>
                    </excludeJUnit5Engines>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
